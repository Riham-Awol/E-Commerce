# URL of the BevSupply backend (no trailing /api). The site proxies /api/* to it,
# so logins use a first-party cookie and no CORS setup is needed.
# Leave unset to run the storefront on its built-in demo data.
BACKEND_URL=http://localhost:4000

# Advanced: call the API directly instead of through the proxy (requires CORS
# via the backend's CLIENT_ORIGIN). Ignored when BACKEND_URL is set.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
