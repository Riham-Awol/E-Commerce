# Server
PORT=4000
NODE_ENV=development
# Allowed frontend origin(s), comma-separated. Only needed when the browser calls
# the API directly; not needed when the frontend proxies via BACKEND_URL.
CLIENT_ORIGIN=http://localhost:3000

# MySQL — either a single connection URL…
# DATABASE_URL=mysql://user:password@host:3306/bevsupply
# …or individual settings:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bevsupply
# Hosted databases usually require TLS:
# DB_SSL=true
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# On first start against an empty database, create tables + load the catalogue.
AUTO_SETUP_DB=true
# Password for the seeded staff accounts (admin/warehouse/finance). In production
# they are only created when this is set.
# ADMIN_PASSWORD=

# JWT — use long random strings in production (required when NODE_ENV=production)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Stripe card payments (optional — card option is hidden when unset).
# Use test keys (sk_test_…) until you're ready to take real money.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<api-host>/api/payments/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Public URL of the website, used for Stripe's return links
# (defaults to the browser's Origin header).
SITE_URL=http://localhost:3000

# Integrations (optional, not yet used)
CLOUDINARY_URL=
GOOGLE_MAPS_KEY=
